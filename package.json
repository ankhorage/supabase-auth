{
  "name": "@ankhorage/supabase-auth",
  "type": "module",
  "version": "1.2.9",
  "description": "Supabase auth adapter implementing shared TypeScript auth contracts.",
  "homepage": "https://github.com/ankhorage/supabase-auth#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/supabase-auth/issues"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/supabase-auth.git"
  },
  "keywords": [
    "typescript",
    "supabase",
    "auth",
    "authentication",
    "oauth",
    "gotrue",
    "secret-store",
    "adapter",
    "session"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox && ankhorage-prettier --write paradox README.md",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.11.0",
    "@ankhorage/paradox": "^0.1.24",
    "@types/bun": "^1.4.1",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ankhorage/contracts": "^8.1.0",
    "@noble/hashes": "2.3.0"
  },
  "packageManager": "bun@1.4.1"
}
