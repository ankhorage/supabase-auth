{
  "name": "@ankhorage/supabase-auth",
  "type": "module",
  "version": "0.4.0",
  "description": "Supabase auth adapter implementing shared TypeScript auth contracts.",
  "homepage": "https://github.com/ankhorage/supabase-auth#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/supabase-auth/issues"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/supabase-auth.git"
  },
  "keywords": [
    "typescript",
    "supabase",
    "auth",
    "authentication",
    "oauth",
    "gotrue",
    "secret-store",
    "adapter",
    "session"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "docs": "paradox && ankhorage-prettier --write paradox README.md",
    "knip": "knip",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.0.6",
    "@ankhorage/paradox": "^0.1.10",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "knip": "^5.88.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ankhorage/contracts": "^3.0.0",
    "@supabase/supabase-js": "2.105.4"
  },
  "packageManager": "bun@1.3.13",
  "knip": {
    "entry": [
      "src/index.ts",
      ".prettierrc.js",
      "eslint.config.mjs",
      "paradox.config.ts"
    ],
    "project": [
      "src/**/*.ts"
    ]
  }
}
